###########################################################
################ filemanager-fastapi (2026) ###############
###########################################################

# --- TaskIQ / Redis ---------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Storage backend --------------------------------------
# One of: local | s3 | gcp
STORAGE_BACKEND=local

# Local backend (used when STORAGE_BACKEND=local)
LOCAL_STORAGE_DIR=/data/media
# Base URL prepended to returned object paths (optional, e.g. https://cdn.example.com)
PUBLIC_BASE_URL=

# S3 / R2 backend (used when STORAGE_BACKEND=s3)
S3_BUCKET=
# Custom endpoint for R2 / MinIO; leave blank for real AWS S3
S3_ENDPOINT_URL=
# Optional CDN / custom domain in front of the bucket (e.g. https://cdn.example.com)
S3_PUBLIC_BASE_URL=
# Region for real AWS S3 (used for auth and virtual-hosted URLs, e.g. eu-central-1)
AWS_REGION=
# Leave blank to use the default credential chain (IAM roles, env, ...)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage backend (used when STORAGE_BACKEND=gcp)
GCP_PROJECT=
GCP_SERVICE_ACCOUNT_FILE=
GCS_BUCKET=

# --- imgproxy ----------------------------------------------
# Hex-encoded; must exactly match the `imgproxy` container's own
# IMGPROXY_KEY/IMGPROXY_SALT env vars. The values below are placeholders --
# generate real ones with `openssl rand -hex 32` and never reuse these.
IMGPROXY_KEY=9a1cc81c9b283ca991dbe6bd183e1c26c96e614674a1a7a101a04316f632f10
IMGPROXY_SALT=e167fa35d77cf0559044dc8aa49e687642a82c2165654f15207942f4b513d69
# Scheme+host imgproxy is reachable at, so the imgproxy_*_url fields in API
# responses are complete, fetchable URLs (not just paths).
IMGPROXY_BASE_URL=http://localhost:8080

# --- Auth -------------------------------------------------
# Comma-separated list of accepted Bearer tokens
FILE_MANAGER_BEARER_TOKENS=

# --- Local S3-compatible testing (MinIO) -------------------
# Uncomment to point the s3 backend at the `minio` compose service
# (docker compose --profile s3-dev up -d minio minio-init) instead of real S3.
# STORAGE_BACKEND=s3
# S3_BUCKET=filemanager-test
# S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
