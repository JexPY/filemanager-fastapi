###########################################################
################ filemanager-fastapi (2026) ###############
###########################################################

# --- TaskIQ / Redis ---------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Metadata store (Postgres) ----------------------------
# System-of-record for every uploaded object (listing, audit, delete,
# idempotency). Both the api and worker connect here. The default points at
# the bundled `db` compose service; override for a managed Postgres.
DATABASE_URL=postgresql://filemanager:filemanager@db:5432/filemanager

# --- Storage backend --------------------------------------
# One of: local | s3 | gcp | b2
STORAGE_BACKEND=local

# Local backend (used when STORAGE_BACKEND=local)
LOCAL_STORAGE_DIR=/data/media
# Base URL prepended to returned object paths (optional, e.g. https://cdn.example.com)
LOCAL_PUBLIC_BASE_URL=

# S3 / R2 backend (used when STORAGE_BACKEND=s3)
S3_BUCKET=
# Custom endpoint for R2 / Garage / other S3-compatible servers; leave blank for real AWS S3
S3_ENDPOINT_URL=
# Optional CDN / custom domain in front of the bucket (e.g. https://cdn.example.com)
S3_PUBLIC_BASE_URL=
# Region for real AWS S3 (used for auth and virtual-hosted URLs, e.g. eu-central-1)
AWS_REGION=
# Leave blank to use the default credential chain (IAM roles, env, ...)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage backend (used when STORAGE_BACKEND=gcp)
GCP_PROJECT=
GCP_SERVICE_ACCOUNT_FILE=
GCS_BUCKET=
# Optional CDN / custom domain in front of the bucket (e.g. https://cdn.example.com)
GCS_PUBLIC_BASE_URL=

# Backblaze B2 backend (used when STORAGE_BACKEND=b2), via B2's S3-compatible
# API. Separate from the S3_*/AWS_* block on purpose: switching backends must not
# silently reuse the other store's credentials.
B2_BUCKET=
# From the B2 console -> Application Keys. Both are REQUIRED: B2 has no ambient
# credential chain, so a blank value is a misconfiguration rather than a fallback.
B2_KEY_ID=
B2_APPLICATION_KEY=
# REQUIRED, e.g. us-west-004. Shown in the console as part of the bucket's S3
# endpoint. SigV4 binds it into the credential scope, so a wrong value fails to
# authenticate rather than merely pointing somewhere else.
B2_REGION=
# Optional. Derived as https://s3.{B2_REGION}.backblazeb2.com when blank.
B2_ENDPOINT_URL=
# Optional CDN / custom domain in front of the bucket (e.g. https://cdn.example.com).
# Fronting B2 with a CDN is the usual production shape -- B2's egress to one is free.
B2_PUBLIC_BASE_URL=

# --- imgproxy ----------------------------------------------
# Hex-encoded; must exactly match the `imgproxy` container's own
# IMGPROXY_KEY/IMGPROXY_SALT env vars. The values below are placeholders --
# generate real ones with `openssl rand -hex 32` and never reuse these.
IMGPROXY_KEY=0e9ef7a7513ea26f06e7294e264bd648091a6d97004c3ba423be0cb36cd95ebd
IMGPROXY_SALT=b353ec2d02fa5b3190b666cc5f2e4a273451c0ea70be78d053d92d565e7e6b67
# Scheme+host imgproxy is reachable at, so the imgproxy_*_url fields in API
# responses are complete, fetchable URLs (not just paths). Since NGINX now proxies
# imgproxy, point this to NGINX (e.g. http://localhost:9000/imgproxy).
IMGPROXY_BASE_URL=http://localhost:9000/imgproxy
# Toggle NGINX Origin Shield (cache lock) for image resizing. Default true.
ENABLE_IMGPROXY_CACHE=true
# Egress allow-list for imgproxy: it fetches whatever source URL is embedded in a
# signed path, and it shares a Docker network with Postgres/Redis (and, on a cloud
# host, the metadata endpoint). Only reachable by someone holding IMGPROXY_KEY/SALT,
# so this is defence in depth against a key leak. Default suits STORAGE_BACKEND=local;
# on s3/gcp set your public/CDN prefix, e.g. https://cdn.example.com/
IMGPROXY_ALLOWED_SOURCES=local://
# Maximum allowed payload size for NGINX. Must be >= MAX_VIDEO_UPLOAD_BYTES.
NGINX_MAX_BODY_SIZE=2000m

# --- Playback & visibility --------------------------------
# The API's own externally-reachable origin (scheme+host). When set, share/
# download responses return absolute URLs (e.g. https://media.example.com/share/
# <token>); when blank they return relative paths and the client prefixes its
# own origin.
PUBLIC_BASE_URL=
# How the `local` backend serves video bytes for GET /files/{id}/download:
#   xaccel  -> return an X-Accel-Redirect that nginx serves (sendfile + Range,
#              app out of the byte path). Requires the nginx service. Prod default.
#   direct  -> Starlette FileResponse (also honours Range). Dev without nginx.
LOCAL_MEDIA_SERVE_MODE=xaccel
# How PRIVATE media is served on the s3/gcp backends (`local` always streams via
# nginx and is unaffected):
#   stream   -> nginx proxies the bytes from an internal location the client cannot
#              address, so no signed URL ever reaches it: nothing to leak, no TTL to
#              size, no expired signature breaking a seek. Costs bandwidth here.
#   redirect -> 302 to a short-lived signed URL. Keeps bytes off this host, but the
#              URL is a bearer token for its lifetime. For high-volume private media.
PRIVATE_MEDIA_SERVE_MODE=stream
# TTL (seconds) for the signed GET URL that /files/{id}/download 302s to on the
# s3/gcp backends. Size it to a viewing session (default 6h); a seek after it
# elapses can hit an expired signature. GCS clamps its own cap at 7 days.
VIDEO_PLAYBACK_URL_TTL_SECONDS=21600
# Caps compressed output duration (seconds) via ffmpeg -t. Longer inputs are truncated.
# VIDEO_MAX_DURATION_SECONDS=60
# Timeout (seconds) for ffmpeg processing (wall-clock kill).
# FFMPEG_TIMEOUT_SECONDS=120
# Timeout (seconds) for the ffprobe metadata probe step (much shorter than FFMPEG_TIMEOUT_SECONDS).
# FFPROBE_TIMEOUT_SECONDS=15
# TTL (seconds) for the presigned URL the worker hands ffmpeg as its input on the
# s3/gcp backends (it reads the object in place instead of downloading it into
# RAM). Must exceed FFMPEG_TIMEOUT_SECONDS. Ignored on `local`.
FFMPEG_INPUT_URL_TTL_SECONDS=3600

# --- Auth -------------------------------------------------
# Comma-separated list of accepted Bearer tokens. Each entry is either a bare
# `secret` (its owner id, used for audit + scoping uploads/deletes, is derived
# as tok_<hash> and never exposes the secret) or `label:secret` (owner = label,
# for a human-readable audit trail). The client always sends just `secret`.
# Example: FILE_MANAGER_BEARER_TOKENS=mobile:s3cr3t-a,admin:s3cr3t-b
FILE_MANAGER_BEARER_TOKENS=

# --- JWT capability tokens (optional) ----------------------
# Shared HS256 secret for short-lived, scoped "capability" JWTs. When set, a
# trusted backend (or this service's POST /upload/presign) can mint tokens that
# a frontend sends straight to /upload/image|video -- via the Authorization
# header OR a ?token=<jwt> query param -- so uploads bypass the backend. Claims:
# sub (owner id), exp (enforced), scopes (must include upload:image/upload:video).
# Blank => JWT auth disabled; only the static tokens above are accepted.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# --- Webhooks (optional video-completion push delivery) ----
# OFF unless BOTH of the next two are set. A client then passes `callback_url`
# on POST /upload/video and the worker POSTs a signed video.completed/
# video.failed payload there. See readme.md "Webhooks".
# WEBHOOK_SIGNING_SECRET=change-me            # HMAC-SHA256 secret (X-Webhook-Signature)
# WEBHOOK_ALLOWED_HOSTS=hooks.example.com     # comma-separated allow-list (SSRF egress control)
# WEBHOOK_ALLOW_INSECURE_HTTP=false           # default https-only
# WEBHOOK_ALLOW_PRIVATE_IPS=false             # default: block private/loopback targets
# WEBHOOK_TIMEOUT_SECONDS=10
# WEBHOOK_MAX_ATTEMPTS=4
# WEBHOOK_RETRY_BACKOFF_SECONDS=1.0

# --- Local S3-compatible testing (Garage) ------------------
# Uncomment to point the s3 backend at the `garage` compose service
# (docker compose --profile s3-dev up -d garage garage-init) instead of real S3.
# AWS_REGION must match Garage's configured s3_region -- SigV4 binds the region
# into the credential scope, so a mismatch is rejected before the request runs.
# STORAGE_BACKEND=s3
# S3_BUCKET=filemanager-test
# S3_ENDPOINT_URL=http://garage:3900
# AWS_REGION=garage
# AWS_ACCESS_KEY_ID=garageadmin
# AWS_SECRET_ACCESS_KEY=garageadminsecretkey
