# Entry reverse proxy for filemanager-fastapi.
#
# Two jobs:
#   1. proxy_pass every normal route to the api container;
#   2. serve `local`-backend video bytes via X-Accel-Redirect -- the app returns
#      an empty response with `X-Accel-Redirect: /internal-media/<key>` and nginx
#      streams the file from the media volume with sendfile (zero-copy) + native
#      HTTP Range. The app never touches the bytes.
#
# On the s3/gcp backends nginx is just the proxy (the object store serves bytes
# via a 302 to a signed URL) -- the /internal-media/ location is only exercised
# by the local backend.

worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile      on;
    tcp_nopush    on;

    # Prevent MIME-confusion attacks and content sniffing
    add_header X-Content-Type-Options "nosniff" always;

    # Must be >= MAX_VIDEO_UPLOAD_BYTES (default 2000 MiB) or nginx 413s uploads
    # before they reach the app's own size check.
    client_max_body_size ${NGINX_MAX_BODY_SIZE};

    # Image cache mapping (toggled via ENABLE_IMGPROXY_CACHE env var)
    map "${ENABLE_IMGPROXY_CACHE}" $imgproxy_cache_zone {
        "true"  img_cache;
        default off;
    }

    # Local storage static serving mapping (gated by STORAGE_BACKEND env var)
    map "${STORAGE_BACKEND}" $local_media_root {
        "local" /data/media;
        default "";
    }

    proxy_cache_path /tmp/nginx_cache keys_zone=img_cache:10m max_size=5g inactive=24h use_temp_path=off;

    # Recover the real client IP when this proxy itself sits behind another one
    # (a TLS terminator / ingress such as Traefik). Without this every request
    # arrives carrying the *upstream proxy's* address, so the per-IP throttle
    # below collapses into a single global bucket shared by every user -- they
    # would rate-limit each other.
    #
    # NGINX_TRUSTED_PROXY_CIDR defaults to 127.0.0.1/32, i.e. effectively off:
    # X-Forwarded-For is attacker-controlled, and trusting it from an untrusted
    # source is a rate-limit bypass. Widen it to the edge proxy's address/subnet
    # only, never 0.0.0.0/0.
    set_real_ip_from ${NGINX_TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Per-IP upload throttle, applied only to the upload routes; read/list/health
    # are unrestricted. Tunable at deploy time because the right value depends on
    # the client: a gallery upload should use POST /upload/images (one request
    # carrying many files, one token spent) rather than N single-file requests.
    limit_req_zone $binary_remote_addr zone=upload_limit:10m rate=${NGINX_UPLOAD_RATE};

    upstream api {
        server api:80;
    }

    upstream imgproxy {
        server imgproxy:8080;
    }

    server {
        listen 80;

        # X-Accel-Redirect target for local-backend video playback. MUST be
        # `internal;` -- it can only be entered via an X-Accel-Redirect from an
        # upstream (proxied) response, never by a direct client request. That is
        # the load-bearing security property: without it, anyone could fetch
        # /internal-media/<key> and bypass the app's visibility/ownership auth
        # entirely. `alias` maps /internal-media/videos/x.mp4 -> the file on the
        # read-only media volume.
        location /internal-media/ {
            internal;
            alias /data/media/;
        }

        # X-Accel-Redirect target for PRIVATE media on the object-store backends
        # (s3/gcp). Same load-bearing `internal;` property as above: reachable
        # only from an upstream response, never by a client.
        #
        # The app signs a short-lived object URL, keeps it server-side, and puts
        # it in an `X-Object-Target` response header; nginx reads it back here and
        # proxies the bytes. The client therefore never receives a signed URL at
        # all -- no leakage window, no TTL to size, no expired-signature failure
        # mid-seek -- and ownership is re-checked on every request rather than
        # once at redirect time.
        location /internal-object/ {
            internal;

            # proxy_pass with a variable is resolved at request time, which
            # requires an explicit resolver. 127.0.0.11 is Docker's embedded DNS.
            resolver 127.0.0.11 ipv6=off valid=30s;
            set $object_target $upstream_http_x_object_target;

            # The client's credentials must not travel to the object store: an
            # Authorization header collides with the presigned SigV4 query
            # signature and the request is rejected.
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
            # Range has to reach the store for seeking to work at all.
            proxy_set_header Range $http_range;
            proxy_set_header If-Range $http_if_range;
            # Required for TLS upstreams addressed by hostname (R2, S3, GCS).
            proxy_ssl_server_name on;
            # Stream rather than accumulate: a large private video must not be
            # buffered to disk here before the client sees a byte.
            proxy_buffering off;
            # Never cache private bytes in the shared origin-shield cache.
            proxy_cache off;

            proxy_pass $object_target;
        }

        # imgproxy reverse proxy with optional cache lock (origin shield)
        location /imgproxy/ {
            proxy_pass http://imgproxy/;
            proxy_cache $imgproxy_cache_zone;
            proxy_cache_lock on;
            proxy_cache_valid 200 24h;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Explicitly deny private and staging paths before any public static route.
        # This is the primary security boundary for local storage static serving.
        location ^~ /private/ {
            return 404;
        }

        location ^~ /raw/ {
            return 404;
        }

        # Serve public prefixes as static files from the local media volume when
        # STORAGE_BACKEND=local (resolved via $local_media_root).
        location /images/ {
            root $local_media_root;
        }

        location /videos/ {
            root $local_media_root;
        }

        location /posters/ {
            root $local_media_root;
        }

        location /files/ {
            root $local_media_root;
            try_files $uri @api;
        }

        # Rate-limit upload endpoints specifically, with tight client_max_body_size per endpoint.
        location = /upload/image {
            client_max_body_size 30m;
            limit_req zone=upload_limit burst=${NGINX_UPLOAD_BURST} nodelay;
            limit_req_status 429;

            error_page 429 = @cors_rate_limited;
            error_page 413 = @cors_too_large;

            proxy_pass         http://api;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;

            proxy_request_buffering off;
        }

        location = /upload/images {
            # Outer backstop (120m) so nginx does not hard-413 bulk uploads before the app
            # can run its graceful per-file `batch_too_large` degradation. Note the real heap
            # ceiling is MAX_BULK_UPLOAD_TOTAL_BYTES + MAX_IMAGE_UPLOAD_BYTES (~75 MB), since
            # checking the budget before reading lets the last admitted file overshoot by one file.
            # With proxy_request_buffering off, Starlette spools parts to disk and beyond-budget
            # slots are rejected without being pulled into the heap.
            client_max_body_size 120m;
            limit_req zone=upload_limit burst=${NGINX_UPLOAD_BURST} nodelay;
            limit_req_status 429;

            error_page 429 = @cors_rate_limited;
            error_page 413 = @cors_too_large;

            proxy_pass         http://api;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;

            proxy_request_buffering off;
        }

        location = /upload/file {
            client_max_body_size 110m;
            limit_req zone=upload_limit burst=${NGINX_UPLOAD_BURST} nodelay;
            limit_req_status 429;

            error_page 429 = @cors_rate_limited;
            error_page 413 = @cors_too_large;

            proxy_pass         http://api;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;

            proxy_request_buffering off;
        }

        location = /upload/video {
            client_max_body_size ${NGINX_MAX_BODY_SIZE};
            limit_req zone=upload_limit burst=${NGINX_UPLOAD_BURST} nodelay;
            limit_req_status 429;

            error_page 429 = @cors_rate_limited;
            error_page 413 = @cors_too_large;

            proxy_pass         http://api;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;

            # Don't buffer the entire upload body (up to 2 GB for video) before
            # forwarding to the API.
            proxy_request_buffering off;
        }

        # CORS-readable versions of the two errors nginx raises by itself on the
        # upload routes. Echoing $http_origin rather than matching an allow-list
        # is safe *here specifically*: the response has an empty body, carries no
        # credentials, and reveals only a status code the caller just provoked.
        # It also cannot produce a duplicate Access-Control-Allow-Origin (which
        # browsers reject outright) because these responses never reach the app,
        # so the app's own CORS middleware never runs for them.
        location @cors_rate_limited {
            add_header 'Access-Control-Allow-Origin' $http_origin always;
            add_header 'Vary' 'Origin' always;
            return 429;
        }

        location @cors_too_large {
            add_header 'Access-Control-Allow-Origin' $http_origin always;
            add_header 'Vary' 'Origin' always;
            return 413;
        }

        location @api {
            proxy_pass         http://api;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_hide_header  X-Object-Target;
        }

        location / {
            proxy_pass         http://api;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            # The signed upstream URL for private media rides this header from
            # the app to the /internal-object/ location above. It must never
            # reach the client -- that would defeat the entire point of
            # streaming instead of redirecting. Hiding it does not affect
            # $upstream_http_x_object_target, which is read from the upstream
            # response before this applies.
            proxy_hide_header  X-Object-Target;
            # If/when streaming uploads land, add `proxy_request_buffering off;`
            # on the upload route so nginx doesn't buffer the whole body (sibling
            # pass -- noted for the interplay, not enabled here).
        }
    }
}
